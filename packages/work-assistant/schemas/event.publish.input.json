{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "subjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "system",
        "id"
      ]
    }
  },
  "required": [
    "type",
    "summary"
  ]
}

{
  "name": "@company-agent/framework",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=24.9.0" },
  "exports": { ".": "./dist/index.js", "./plugin-sdk": "./dist/plugin-sdk.js" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:console": "node scripts/verify-console-live.mjs",
    "check": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "start": "node --env-file=.env dist/cli.js serve",
    "console": "node scripts/open-console.mjs",
    "console:studio": "node scripts/open-studio-console.mjs",
    "studio": "node --env-file=.env scripts/start-studio-isolated.mjs",
    "build:harness:studio": "node scripts/build-company-harness.mjs --profile=studio",
    "package:source": "node scripts/source-package.mjs",
    "bot": "node scripts/bot.mjs",
    "harness": "node scripts/harness.mjs",
    "build:employee-client": "node scripts/build-employee-client.mjs",
    "employee:demo": "node scripts/open-employee-demo.mjs",
    "smoke:bot": "node --env-file=.env scripts/smoke-bot.mjs",
    "db:setup": "node scripts/local-postgres.mjs",
    "smoke": "node --env-file=.env dist/cli.js smoke",
    "smoke:harness": "node --env-file=.env dist/cli.js harness-smoke",
    "demo": "node --env-file=.env dist/cli.js demo"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.2",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "pg-boss": "12.38.2",
    "semver": "7.7.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/semver": "7.7.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
